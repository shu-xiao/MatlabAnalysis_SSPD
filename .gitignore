# === MATLAB standard ignores (from remote) ===

# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag

# buildtool cache folder
.buildtool/

# === Local-only exclusions ===

# Raw data folder
SNSPD_data/

# Claude Code per-machine / project config
.claude/
CLAUDE.md

# Local TDMS test files (large binary data)
test/

# Local measurement data and results
IPcurve.txt
*_efficiency.txt
*.fig

# Local-only MATLAB scripts (not part of the public analysis pipeline)
SNSPD_TDMS_convert.m
SNSPD_TDMS_convert_charGPT.m
SNSPD_TDMS_convert_charGPT.py
SNSPD_TDMS_convert_multifolder.m
SMSPD_ana_for_eff_time_jitter_tdms.m
TCSPC_time_jitter.m
hot_belt_model.m
makefolder.m
rename_file.m
testPath.m

# Local-modified copies of GitHub-tracked scripts
*_local.m
